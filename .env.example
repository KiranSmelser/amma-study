# Box Client Credentials Grant settings
# Copy these variable names into your approved secret-storage mechanism.
# Never place real credential values in this file.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=

# Defaults for retrieving BOX_CLIENT_SECRET from macOS Keychain when the
# variable above is intentionally blank.
BOX_KEYCHAIN_SERVICE=amma-study-box-client-secret
BOX_KEYCHAIN_ACCOUNT=amma-study

# Box folder IDs are configuration values, not credentials.
BOX_AMMA_RAW_FOLDER_ID=414770123096
BOX_AMMA_IDENTIFIERS_FOLDER_ID=414771124684
BOX_AMMA_PROCESSED_FOLDER_ID=414770090205
BOX_AMMA_DOCUMENTATION_FOLDER_ID=414770552414
BOX_AMMA_REPORTS_FOLDER_ID=418382497628
